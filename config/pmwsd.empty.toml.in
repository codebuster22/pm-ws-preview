# Template for pmwsd.empty.toml: ./setup.sh renders it with this clone's absolute path and
# the control socket path. Starts the daemon with no markets; add them with `pmwsctl add <slug>`.
control_socket = "__SOCKET__"
metrics_listen = "127.0.0.1:9090"
markets_per_shard = 100
markets = []

[delivery]
directory = "__REPO__/run"
